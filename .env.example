# Copy this file to .env.local and fill in the values from your Supabase
# project settings (Project Settings -> API).
#
# The anon key is safe to expose in the browser — it has no power on its
# own beyond what the Row Level Security policies in supabase/schema.sql
# allow for a logged-in user.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
